APP_ENV=local
APP_DEBUG=1
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Khartoum
SESSION_SECURE=0
SESSION_IDLE_TIMEOUT_SECONDS=
LOGIN_MAX_ATTEMPTS=
LOGIN_WINDOW_SECONDS=
LOGIN_LOCKOUT_SECONDS=
AUTH_THROTTLE_KEY=
AUDIT_RETENTION_DAYS=
AUTH_ATTEMPT_RETENTION_DAYS=
STREAM_PROVIDER=cloudflare_stream
STORAGE_PROVIDER=
UPLOAD_MAX_BYTES=
QUIZ_MAX_ATTEMPTS=
QUIZ_DURATION_MINUTES=
QUIZ_RESULT_VISIBILITY=
QUIZ_INCOMPLETE_ATTEMPT_POLICY=

# Required before sending messages. Owner decision pending; do not copy invented values.
MESSAGING_RATE_LIMIT_COUNT=
MESSAGING_RATE_LIMIT_WINDOW_SECONDS=
# QUIZ_RESULT_VISIBILITY: AFTER_MANAGER_APPROVAL (each student's graded result)
# QUIZ_INCOMPLETE_ATTEMPT_POLICY: MANAGER_REVIEW (classify at expiry; manager may grant one retry)

DB_CONNECTION=pgsql
# Set DATABASE_URL only when using a provider URL such as Neon; it takes precedence over DB_*.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alesnad_platform
DB_USERNAME=alesnad_app
DB_PASSWORD=replace-with-a-local-password
DB_SSLMODE=prefer

# Keep uploaded files outside public/ and outside version control.
PRIVATE_STORAGE_PATH=storage/private

# Cloudflare Stream (API Token requires Stream Read/Write; direct video upload needs Stream Write)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Video uploads can temporarily use Mux without changing STREAM_PROVIDER.
VIDEO_UPLOAD_PROVIDER=cloudflare_stream
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
